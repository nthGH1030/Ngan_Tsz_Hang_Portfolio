---
import '../styles/global.css';
import sourceSansLatin from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Ngan Tsz Hang | Portfolio',
	description = 'Portfolio of Ngan Tsz Hang, covering real estate project delivery, workflow automation, AI prototyping, and software projects built with modern web tools.',
	noindex = false,
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Ngan Tsz Hang',
	alternateName: 'Kelvin Ngan',
	description,
	jobTitle: 'Project Manager and Software Builder',
	sameAs: [
		'https://github.com/nthGH1030',
		'https://www.linkedin.com/in/kelvin-ngan-3b098a1a3',
	],
	knowsAbout: [
		'Real estate project delivery',
		'Building surveying',
		'Workflow automation',
		'AI prototyping',
		'React',
		'Astro',
		'Node.js',
	],
	...(canonicalUrl ? { url: canonicalUrl } : {}),
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: title,
	description,
	...(canonicalUrl ? { url: canonicalUrl } : {}),
};
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function () {
				try {
					const stored = localStorage.getItem('theme');
					const dark =
						stored === 'dark' ||
						(stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
					document.documentElement.classList.toggle('dark', dark);
				} catch (error) {
					/* localStorage can throw in private mode */
				}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link rel="preload" href={sourceSansLatin} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
	</head>
	<body>
		<a href="#home" class="skip-link">Skip to content</a>
		<slot />
		<script is:inline>
			(function () {
				const key = 'theme';

				function isDark() {
					return document.documentElement.classList.contains('dark');
				}

				function syncToggles() {
					const dark = isDark();
					document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
						button.setAttribute('aria-pressed', String(dark));
						button.setAttribute(
							'aria-label',
							dark ? 'Switch to light mode' : 'Switch to dark mode',
						);
					});
				}

				function apply(theme) {
					document.documentElement.classList.toggle('dark', theme === 'dark');
					syncToggles();
				}

				document.addEventListener('click', function (event) {
					const target = event.target;
					if (!(target instanceof Element)) {
						return;
					}
					const button = target.closest('[data-theme-toggle]');
					if (!button) {
						return;
					}
					const next = isDark() ? 'light' : 'dark';
					try {
						localStorage.setItem(key, next);
					} catch (error) {
						/* ignore */
					}
					apply(next);
				});

				const media = window.matchMedia('(prefers-color-scheme: dark)');
				media.addEventListener('change', function (event) {
					try {
						if (localStorage.getItem(key)) {
							return;
						}
					} catch (error) {
						return;
					}
					apply(event.matches ? 'dark' : 'light');
				});

				syncToggles();
			})();
		</script>
	</body>
</html>
