---
import { Picture, getImage } from 'astro:assets';
import { IoIosArrowForward } from "react-icons/io";
import portrait from '../assets/images/portrait.jpg';
import BlurFrame from '../components/media/BlurFrame.astro';

const portraitBlur = await getImage({
	src: portrait,
	width: 24,
	format: 'webp',
	quality: 20,
});
---

<section id="about" data-main-section class="scroll-mt-24 py-16 md:py-24">
    <div class="page-shell">
        <div class="flex items-center">
            <h2 class="whitespace-nowrap font-bold text-xl md:text-2xl text-ink">1. About me</h2>
            <div class="w-full bg-line h-px ml-4"></div>
        </div>
        <div class="mt-8 flex flex-col gap-8 md:flex-row">
            <div class="min-w-0 flex-1 max-w-3xl space-y-6 text-base text-muted">
                <p class="text-muted">
                    I am a chartered building surveyor turned software engineer,
                    passionate about leveraging technology to solve real-world problems.
                    In my free time, I have developed and deployed solutions that address
                    challenges encountered in my professional work, some of which have been
                    adopted to enhance productivity and support educational initiatives.
                    I actively contribute to brainstorming sessions focused on automation and
                    AI adoption within the enterprise, identifying practical use cases
                    and creating technical demos to drive innovation and efficiency.
                </p>
                <div>
                <p class="text-base text-muted">Technologies I work with:</p>
                <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4">
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Javascript</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Typescript</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Node.js</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">ReactJS</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Tailwind</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Astro</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">HTML & CSS</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">OpenAI</span>
                    </li>
                    <li class="flex items-center gap-4 text-accent">
                        <IoIosArrowForward aria-hidden="true"/>
                        <span class="text-sm text-muted">Azure</span>
                    </li>
                </ul>
                </div>
            </div>
            <div class="relative flex-shrink-0 mx-auto md:mx-0 self-start group">
                <div class="absolute top-4 left-4 w-full h-full rounded-lg border-2 border-accent -z-10
                              transition-transform duration-200 group-hover:translate-y-1 group-hover:translate-x-1"></div>
                <BlurFrame
                    blurSrc={portraitBlur.src}
                    class="relative w-[200px] md:w-[300px] aspect-square rounded-lg shadow-lg shadow-accent/25 transition duration-200 group-hover:-translate-y-1 group-hover:-translate-x-1 group-hover:shadow-xl group-hover:shadow-accent/30"
                >
                <Picture
                    src={portrait}
                    alt="Portrait of Ngan Tsz Hang"
                    widths={[200, 300, 600]}
                    sizes="(min-width: 768px) 300px, 200px"
                    formats={['webp']}
                    quality={80}
                    width={300}
                    height={300}
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'relative block w-full' }}
                    class="relative w-full aspect-square h-auto object-cover rounded-lg block"
                />
                </BlurFrame>
            </div>
        </div>
    </div>
</section>
