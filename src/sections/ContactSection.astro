---
import Reference from "../components/contact/Reference.astro"
---

<section id="contact" data-main-section class="scroll-mt-24 py-16 md:py-24">
    <div class="page-shell flex flex-col gap-8">
        <div class="max-w-3xl self-center flex flex-col items-center gap-4 text-center">
            <h2 class="text-3xl text-ink">
                Let's Connect
            </h2>
            <p class="text-muted">
                I am actively seeking new opportunities to work,
                learn, and collaborate with others.
                If you have a project, position, or idea where we can grow together,
                feel free to reach out!
            </p>
            <a
                href="mailto:nth.dev@icloud.com"
                class="btn-secondary mt-4">
                Contact Me
            </a>
        </div>
        <Reference/>
    </div>
</section>
