---
const deliveryBullets = [
	'Managed multiple properties as a project manager, coordinating leasing and property-management teams to deliver construction projects on schedule and within budget while maintaining compliance.',
	'Led technical planning and vendor coordination for project execution, balancing operational constraints with delivery quality and cost control.',
	'Acted as a bridge between operations and management to smoothen property operation.',
];
---

<div class="flex flex-col gap-8">
	<article class="rounded-2xl border border-blue-100 bg-blue-50/50 p-5 md:p-6">
		<div class="flex flex-wrap items-center gap-2">
			<span class="inline-flex rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white">
				Software
			</span>
			<p class="text-sm font-medium text-blue-800">Internal tools and automation</p>
		</div>
		<h3
			class="mt-4 text-lg font-semibold text-gray-900"
			style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
		>
			Technical contributor, digitalization team
		</h3>
		<p class="mt-1 text-sm text-gray-600">
			<a
				href="https://www.gawcapital.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-blue-700 font-medium hover:underline"
			>Gaw Capital Asset Management Limited</a>
		</p>
		<p class="mt-3 text-sm leading-6 text-gray-700 max-w-3xl">
			Appointed as a designated technical contributor on the digitalization team. Design and build AI solutions for internal users.
		</p>
		<ul class="mt-5 grid gap-3">
			<li class="rounded-xl border border-blue-200 bg-white p-4 shadow-sm">
				<p
					class="font-semibold text-gray-900"
					style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
				>
					Serverless OCR workflow
				</p>
				<p class="mt-2 text-sm leading-6 text-gray-700">
					Documents uploaded to <strong>SharePoint</strong> are synchronized to <strong>Blob Storage</strong>, processed with <strong>OCR</strong> on <strong>Azure Functions</strong>, and persisted to <strong>PostgreSQL</strong> via <strong>SQLAlchemy</strong>. Secrets are managed in <strong>Azure Key Vault</strong>, and <strong>GitHub Actions</strong> automates UAT deployment.
				</p>
			</li>
			<li class="rounded-xl border border-blue-200 bg-white p-4 shadow-sm">
				<p
					class="font-semibold text-gray-900"
					style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
				>
					Excel form automation
				</p>
				<p class="mt-2 text-sm leading-6 text-gray-700">
					Desktop workflow that reads a master table and generates payment-request forms, built as an earlier self-initiated tool for the same operational friction.
				</p>
			</li>
		</ul>
	</article>

	<article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 md:p-6">
		<div class="flex flex-wrap items-center gap-2">
			<span class="inline-flex rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-white">
				Building Surveying 
			</span>
		</div>
		<h3
			class="mt-4 text-lg font-semibold text-gray-900"
			style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
		>
			Assistant Project Manager
		</h3>
		<p class="mt-1 text-sm text-gray-600">
			<a
				href="https://www.gawcapital.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-blue-700 font-medium hover:underline"
			>Gaw Capital Asset Management Limited</a>
			· 2018 – Present
		</p>
		<p class="mt-3 text-sm leading-6 text-gray-700 max-w-3xl">
			Day job in real-estate renovation delivery. This is the setting the software work was built in, not the lead identity on this site.
		</p>
		<ul class="mt-4 space-y-3">
			{deliveryBullets.map((item) => (
				<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
					<span>{item}</span>
				</li>
			))}
		</ul>
	</article>

	<details class="rounded-2xl border border-dashed border-slate-300 bg-white p-4 md:px-5 md:py-4">
		<summary class="cursor-pointer text-sm font-semibold text-gray-800 marker:text-gray-500">
			Earlier built-environment roles, 2015–2018
		</summary>
		<p class="mt-3 text-sm text-gray-600">
			Surveying and consultancy work before the current role. Included for a complete timeline, not as the hiring focus.
		</p>
		<div class="mt-5 space-y-6">
			<article>
				<h4
					class="font-semibold text-gray-900"
					style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
				>
					Assistant Building Surveyor
				</h4>
				<p class="text-sm text-gray-600">United Consultancy Limited · 2017 – 2018</p>
				<ul class="mt-3 space-y-2">
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Managed large-scale Asset Enhancement Initiatives (AEI) for major institutional clients, including Link REIT, overseeing full-lifecycle renovation projects from technical planning to final delivery.</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Led technical coordination and stakeholder liaison, balancing client requirements with contractor capabilities.</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Acted as a bridge between clients, contractors, and statutory bodies on regulatory requirements.</span>
					</li>
				</ul>
			</article>
			<article>
				<h4
					class="font-semibold text-gray-900"
					style="font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
				>
					Assistant Building Surveyor
				</h4>
				<p class="text-sm text-gray-600">ISS Building Consultancy · 2015 – 2017</p>
				<ul class="mt-3 space-y-2">
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Managed government term contracts for large-scale building operations.</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Produced and managed detailed technical drawings in AutoCAD for client review.</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
						<span>Led Mandatory Building Inspection Scheme (MBIS) projects and building condition surveys for private owners.</span>
					</li>
				</ul>
			</article>
		</div>
	</details>
</div>
