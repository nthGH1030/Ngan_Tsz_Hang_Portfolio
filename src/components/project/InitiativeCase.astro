---
interface Props {
	title: string;
	tags: string[];
	achievement?: string;
	id?: string;
}

const { title, tags, achievement, id } = Astro.props;
---

<article
	id={id}
	class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6"
>
	<h3 class="text-lg font-semibold text-gray-900">
		{title}
	</h3>
	<div class="mt-3 max-w-3xl text-sm leading-6 text-gray-700">
		<slot name="description" />
	</div>
	<ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech stack">
		{tags.map((tag) => (
			<li class="rounded-full border border-blue-200 bg-blue-50 px-2 py-1 text-xs font-medium whitespace-nowrap text-blue-800">
				{tag}
			</li>
		))}
	</ul>
	{achievement && (
		<p class="mt-4 border-t border-blue-100 pt-4 text-sm leading-6 text-slate-700">
			<span class="mb-0.5 block text-[11px] font-bold uppercase tracking-[0.12em] text-blue-700">
				Impact
			</span>
			{achievement}
		</p>
	)}
	<div class="empty:hidden mt-5">
		<slot name="demo" />
	</div>
</article>
