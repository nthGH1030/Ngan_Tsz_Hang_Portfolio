---
import BackgroundTimeline from '../islands/BackgroundTimeline'
import Qualification from '../components/experience/Qualification.astro'
---
<section id="background" data-main-section class="min-h-screen snap-start">
	<div class="flex flex-col pt-24 pb-8 min-h-screen">
		<div class="shrink-0 px-[clamp(4rem,12vw,16rem)] flex items-center">
			<h2 class="whitespace-nowrap font-bold text-xl md:text-2xl text-ink">4. Background</h2>
			<div class="w-full bg-line h-px ml-2"></div>
		</div>
		<div class="flex-1">
			<div class="px-[clamp(2rem,12vw,16rem)] mt-8">
				<BackgroundTimeline client:visible />
			</div>
			<div class="px-[clamp(2rem,12vw,16rem)]">
				<Qualification />
			</div>
		</div>
	</div>
</section>
