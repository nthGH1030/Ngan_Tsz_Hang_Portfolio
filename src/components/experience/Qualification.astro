---
import QualficationCard from './QualificationCard'
import { optimizeImage } from '../../utils/optimize-image'
import awsBadge from '../../assets/images/aws-badge.png'
import cs50x from '../../assets/images/cs50x.png'

const awsImg = await optimizeImage(awsBadge, [112, 300, 600])
const cs50Img = await optimizeImage(cs50x, [112, 400, 800, 1200, 1600])
---

<section id="qualification"> 
    <div class = "max-w-3xl">
        <h3
            class = "text-xs font-semibold tracking-wider text-muted uppercase"
        >Certifications</h3>
    </div>
    <div class = "max-w-3xl mt-4 border-l-2 border-line space-y-4">
        <QualficationCard
            client:visible
            title = "AWS Certified Solutions Architect - Associate"
            img = {awsImg}
            date = "Nov 2024"
        />
        <QualficationCard
            client:visible
            title = "CS50"
            img = {cs50Img}
            date = "Oct 2023"
        />
    </div>
</section>
