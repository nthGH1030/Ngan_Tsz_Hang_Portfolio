---
import TopBar from '../navigation/TopBar.astro'
import BottomBar from '../navigation/BottomBar.tsx'
import HomeSection from '../../sections/HomeSection.astro'
import AboutSection from '../../sections/AboutSection.astro'
import ExperienceSection from '../../sections/ExperienceSection.astro'
import OtherProjectsSection from '../../sections/OtherProjectsSection.astro'
import BackgroundSection from '../../sections/BackgroundSection.astro'
import ContactSection from '../../sections/ContactSection.astro'
---

<div>
    <header id="top-bar" class="relative z-[300]">
        <TopBar/>
    </header>
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-[200] h-24">
        <div class="absolute inset-0 backdrop-blur-sm"></div>
        <div class="absolute inset-x-0 bottom-0 h-8 bg-gradient-to-b from-page/40 to-transparent"></div>
    </div>
    <main id="content" class="relative z-0">
        <HomeSection/>
        <AboutSection/>
        <ExperienceSection/>
        <OtherProjectsSection/>
        <BackgroundSection/>
        <ContactSection/>
        <BottomBar/>
    </main>
</div>

<script>
    const initializeWindowScroll = () => {
        const topBar = document.getElementById('top-bar');

        if (!(topBar instanceof HTMLElement)) {
            return;
        }

        let lastScroll = window.scrollY;
        let isBarHidden = false;

        const hideBar = () => {
            if (isBarHidden) {
                return;
            }

            topBar.classList.remove('topbar-slide-in');
            topBar.classList.add('topbar-slide-out');
            isBarHidden = true;
        };

        const showBar = () => {
            if (!isBarHidden) {
                return;
            }

            topBar.classList.remove('topbar-slide-out');
            topBar.classList.add('topbar-slide-in');
            isBarHidden = false;
        };

        window.addEventListener('scroll', () => {
            const next = window.scrollY;

            if (next > lastScroll && next > 8) {
                hideBar();
            } else if (next < lastScroll) {
                showBar();
            }

            lastScroll = next;
        }, { passive: true });

        const skipLink = document.querySelector('.skip-link');
        skipLink?.addEventListener('click', (event) => {
            const home = document.getElementById('home');
            if (!(home instanceof HTMLElement)) {
                return;
            }

            event.preventDefault();
            home.focus({ preventScroll: true });
            home.scrollIntoView();
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeWindowScroll, { once: true });
    } else {
        initializeWindowScroll();
    }
</script>
